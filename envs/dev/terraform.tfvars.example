# Copie para terraform.tfvars (gitignored) e preencha.

# ── OCI auth ──────────────────────────────────────────────
tenancy_ocid     = "ocid1.tenancy.oc1..xxxxx"
user_ocid        = "ocid1.user.oc1..xxxxx"
fingerprint      = "aa:bb:cc:dd:ee:ff:..."
private_key_path = "~/.oci/oci_api_key.pem"
region           = "sa-saopaulo-1"
compartment_id   = "ocid1.compartment.oc1..xxxxx"

# ── Naming ────────────────────────────────────────────────
project     = "ost"
environment = "dev"

# ── Acesso SSH ────────────────────────────────────────────
ssh_public_key   = "ssh-ed25519 AAAA... guy@laptop"
ssh_allowed_cidr = "0.0.0.0/0"   # restrinja em prod

# ── Sizing VM (default x86 AMD E4.Flex — pago) ────────────
# vm_shape           = "VM.Standard.E4.Flex"   # ou "VM.Standard.A1.Flex" para Always Free ARM
# vm_ocpus           = 2
# vm_memory_gbs      = 12
# vm_boot_volume_gbs = 50

# ── Sizing DB (NÃO é Always Free) ─────────────────────────
# db_shape                 = "VM.Standard.E4.Flex"
# db_ocpus                 = 2
# db_memory_gbs            = 8
# db_storage_gbs           = 50
# db_is_regionally_durable = true
# db_instance_count        = 1
# db_backup_retention_days = 7
# db_name                  = "ost"
